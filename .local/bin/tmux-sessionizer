#!/usr/bin/env bash

if ! command -v tmux >/dev/null; then
    echo "Warning: tmux is required but not installed. Skipping..."
    exit 0
fi

FAV_DIRS=$(fav-dirs)

if command -v zoxide >/dev/null; then
    FRECENCY_DIRS=$(zoxide query -l)
fi

# Combine lists, filter out duplicates, and pass to fzf
selected=$(echo -e "$FAV_DIRS\n$FRECENCY_DIRS" | awk '!seen[$0]++' | fzf)

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2>/dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name 2>/dev/null || tmux attach-session -t $selected_name