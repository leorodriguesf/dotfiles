[user]
  name = Leonardo Rodrigues Ferreira
  email = leorodriguesf95+dev@gmail.com

[alias]
  g = log --all --graph --oneline
  s = status --short
  d = difftool
  ds = difftool --staged
  c = commit --verbose
  ca = commit --verbose --all
  l = log --patch --stat
  unstage = restore --staged --
  discard = restore --
  last = log --patch --stat -1 HEAD

[core]
  editor = vim
  excludesfile = ~/.config/git/.gitignore_global

[merge]
  tool = vimdiff

[diff]
  tool = vimdiff

[difftool]
  prompt = false

[color "diff"]
  meta = blue
  old = black red strike
  new = black green italic
  context = yellow bold # context (ie: unchanged lines) text

[pull]
  ff = only

# Allow override for work profile
[includeIf "gitdir:~/work/"]
  path = ~/work/.gitconfig_work